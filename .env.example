# Account sync (optional). Without these the app builds and runs exactly as
# before — sync simply isn't offered, and everything stays local.
#
# Get them from your Supabase project — two different pages in the current
# dashboard: the URL is under Settings → Data API, the key under
# Settings → API Keys. supabase/SETUP.md walks through it.
#
# The anon key is PUBLISHABLE by design: it only lets a request authenticate,
# and every row is then scoped to its owner by the row-level security policies
# in supabase/schema.sql. It is still configuration rather than source — copy
# this file to `.env.local`, which is gitignored, and never commit real values.
# The service_role key is a different thing entirely and must NEVER appear here
# or anywhere in the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
